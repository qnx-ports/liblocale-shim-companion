# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=liblocale-shim
pkgver=0.1.0
pkgrel=2
pkgdesc="Felix's locale.h shim"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
options="!check"
subpackages="$pkgname-dev"
source="liblocale.tar.gz
    "
builddir="$srcdir"/liblocale
build() {
    ./make.sh
}

package() {
    mkdir -p "$pkgdir"/usr

    cd "$builddir"
    PREFIX="$pkgdir"/usr ./install.sh
}

